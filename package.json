{
  "name": "youtube-ai-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "studio": "NODE_USE_ENV_PROXY=1 node --env-file-if-exists=.env.local --import tsx scripts/studio.ts",
    "worker:once": "NODE_USE_ENV_PROXY=1 node --env-file-if-exists=.env.local --import tsx scripts/worker.ts",
    "gen-secrets": "node --env-file-if-exists=.env.local --import tsx scripts/gen-secrets.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.1",
    "drizzle-orm": "^0.45.4",
    "postgres": "^4.1.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "typescript": "^5",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
