# Copy to .env.local for local runs, or add each variable in your host's settings
# (Vercel → Project → Settings → Environment Variables, GitHub → Settings → Secrets).
# Never commit real values. Generate random values with:  npm run gen-secrets

# --- Required ---
DATABASE_URL=postgres://user:password@host:5432/dbname
SESSION_SECRET=            # >= 32 random characters (web app only; the worker does not need it)
ADMIN_PASSWORD_HASH=       # npm run hash-password -- "your long password"   (format scrypt:...) — REQUIRED in production
# ADMIN_PASSWORD=          # development only (min 10 chars); rejected when NODE_ENV=production

# --- AI (optional: without a key the app runs in free mock mode) ---
LLM_PROVIDER=mock          # mock | anthropic — REQUIRED in production (no silent fallback); "auto" is dev-only
# ANTHROPIC_API_KEY=

# --- Optional ---
# ENCRYPTION_KEY=          # base64 of 32 random bytes — required from phase 3 (stores the YouTube token encrypted)
# CRON_SECRET=             # protects /api/worker/tick (runs mock jobs only; refuses real Claude work)
# MIGRATION_DATABASE_URL=  # DIRECT (non-pooled) connection for migrations; required if DATABASE_URL is a pooler URL
# TRUSTED_IP_HEADER=       # header with the real client IP set by your host (fly-client-ip, cf-connecting-ip...); auto on Vercel
# WORKER_INLINE=false      # true = process jobs inside the web process after each action (single container)
PUBLISHING_MODE=dry_run    # only dry_run exists until phase 3 is built and tested
