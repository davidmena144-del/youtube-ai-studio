# Copy to .env.local for local runs, or add each variable as a GitHub Actions secret.
# Never commit real values.
#
# ZERO-SPEND RULE: there is no AI API key in this project. Claude work runs inside Claude Code
# sessions on the owner's subscription. Every process REFUSES TO START if a paid-provider credential
# such as ANTHROPIC_API_KEY, OPENAI_API_KEY or ELEVENLABS_API_KEY is present (src/core/cost-guard.ts).

# --- Required ---
DATABASE_URL=postgres://user:password@host:5432/dbname   # Neon free project (pooled URL is fine)

# --- Required for migrations if DATABASE_URL is a pooler URL ---
# MIGRATION_DATABASE_URL=   # DIRECT (non-pooled) connection used only by npm run db:migrate

# --- Worker only ---
# ENCRYPTION_KEY=           # npm run gen-secrets — base64 of 32 bytes; encrypts the YouTube token (Phase 5)
# WORKER_TIME_BUDGET_MS=1200000
# WORKER_MIN_REMAINING_MS=720000
