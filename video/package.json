{
  "name": "youtube-ai-studio-video",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion motion graphics for YouTube AI Studio",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render StudioIntro out/studio-intro.mp4 --browser-executable=/opt/pw-browsers/chromium --concurrency=2",
    "still": "remotion still StudioIntro out/poster.png --frame=150 --browser-executable=/opt/pw-browsers/chromium"
  },
  "dependencies": {
    "@remotion/cli": "4.0.543",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.543"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}
